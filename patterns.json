{
  "notes": [
    "Factory pattern list for Redactor. The app copies this file to ~/Library/Application Support/Redactor/patterns.json and reads that copy.",
    "Do not put real secrets in this file.",
    "Passwords, keys, tokens, and secrets are matched, including a trailing app_key or token."
  ],
  "replacement": "[redacted]",
  "minimumValueLength": 4,
  "ignoreValues": [
    "changeme",
    "change_me",
    "placeholder",
    "your_api_key",
    "your-api-key",
    "your_token",
    "your_password",
    "xxx",
    "xxxx",
    "xxxxx",
    "redacted",
    "[redacted]",
    "none",
    "null",
    "nil",
    "true",
    "false",
    "undefined",
    "todo",
    "test",
    "testing",
    "example",
    "sample",
    "secret",
    "password",
    "token",
    "apikey",
    "api_key",
    "insert_key_here",
    "replace_me",
    "enabled",
    "disabled",
    "yes",
    "no",
    "on",
    "off",
    "required",
    "optional",
    "localhost",
    "bearer",
    "basic"
  ],
  "parameterNames": [
    "access_key",
    "access_key_id",
    "access_secret",
    "access_token",
    "account_key",
