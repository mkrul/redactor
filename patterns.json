    "cipher_key",
    "client_key_data",
    "client_secret",
    "cloudflare_api_token",
    "config_key",
    "consumer_key",
    "consumer_secret",
    "credentials",
    "database_password",
    "datadog_api_key",
    "db_pass",
    "db_password",
    "dd_api_key",
    "digitalocean_token",
    "do_token",
    "encryption_key",
    "external_id_key",
    "feed_key",
    "github_token",
