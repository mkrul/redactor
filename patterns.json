    "secret",
    "secret_access_key",
    "secret_key",
    "secret_key_base",
    "secret_token",
    "security_token",
    "sendgrid_api_key",
    "sentry_auth_token",
    "service_account_key",
    "session_token",
    "shared_access_key",
    "shared_key",
    "signing_key",
    "signing_secret",
